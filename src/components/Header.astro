---
import { profile } from '../data/profile';

const nav = [
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Docencia', href: '#docencia' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="sticky top-0 z-10 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight">
      {profile.shortName.toLowerCase().replace(' ', '')}<span class="text-accent-500">.dev</span>
    </a>
    <nav class="hidden gap-6 text-sm text-zinc-600 sm:flex dark:text-zinc-400">
      {nav.map((item) => (
        <a href={item.href} class="transition-colors hover:text-zinc-900 dark:hover:text-white">{item.label}</a>
      ))}
    </nav>
  </div>
</header>
