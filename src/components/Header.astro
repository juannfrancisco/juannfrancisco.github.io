---
import { profile } from '../data/profile';

const nav = [
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Docencia', href: '#docencia' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header data-header class="sticky top-0 z-20 border-b border-transparent transition-colors duration-300 data-scrolled:border-zinc-200/70 data-scrolled:bg-zinc-50/80 data-scrolled:backdrop-blur-md dark:data-scrolled:border-zinc-800/70 dark:data-scrolled:bg-zinc-950/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="group font-mono text-sm font-semibold tracking-tight">
      {profile.shortName.toLowerCase().replace(' ', '')}<span class="text-accent-500 transition-colors group-hover:text-accent-400">.dev</span>
    </a>
    <nav class="hidden items-center gap-1 text-sm text-zinc-600 sm:flex dark:text-zinc-400">
      {nav.map((item) => (
        <a
          href={item.href}
          data-nav={item.href.slice(1)}
          class="rounded-full px-3 py-1.5 transition-colors hover:text-zinc-900 data-active:bg-zinc-900/5 data-active:text-zinc-900 dark:hover:text-white dark:data-active:bg-white/10 dark:data-active:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href="#contacto"
      class="rounded-full bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white sm:hidden dark:bg-white dark:text-zinc-900"
    >
      Contacto
    </a>
  </div>
  <span data-progress aria-hidden="true" class="absolute inset-x-0 -bottom-px h-0.5 origin-left scale-x-0 bg-accent-500"></span>
</header>
