---
interface Props {
  title?: string;
  type?: 'info' | 'tip' | 'warning';
}

const { title, type = 'info' } = Astro.props;

const styles = {
  info: {
    border: 'border-accent-500/30',
    bg: 'bg-accent-500/5',
    badge: 'text-accent-600 dark:text-accent-400',
    label: 'Nota',
  },
  tip: {
    border: 'border-emerald-500/30',
    bg: 'bg-emerald-500/5',
    badge: 'text-emerald-600 dark:text-emerald-400',
    label: 'Recomendación',
  },
  warning: {
    border: 'border-amber-500/30',
    bg: 'bg-amber-500/5',
    badge: 'text-amber-600 dark:text-amber-400',
    label: 'Atención',
  },
}[type];
---

<aside class:list={['not-prose my-6 rounded-2xl border p-5', styles.border, styles.bg]}>
  <p class:list={['font-mono text-xs font-semibold tracking-wider uppercase', styles.badge]}>
    {title ?? styles.label}
  </p>
  <div class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
    <slot />
  </div>
</aside>
