---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ogBlog from '../../assets/og-blog.svg';
import { profile } from '../../data/profile';
import { formatDate, getReadingTime, sortAndFilterPosts } from '../../utils/blog';

const allPosts = await getCollection('blog');
const posts = sortAndFilterPosts(allPosts);
---

<Base
  title={`Blog — ${profile.name}`}
  description="Notas técnicas sobre arquitectura cloud, diseño de sistemas distribuidos y liderazgo de equipos de software."
  image={ogBlog}
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[36rem] overflow-hidden">
    <div class="absolute top-16 left-1/2 size-[30rem] -translate-x-1/2 rounded-full bg-accent-500/12 blur-3xl sm:left-2/3"></div>
  </div>

  <Header />

  <main class="mx-auto min-h-[calc(100svh-8.5rem)] max-w-6xl px-4 pt-12 pb-24 sm:px-6 sm:pt-16">
    <header class="max-w-2xl">
      <div class="flex items-center gap-3">
        <p class="font-mono text-xs tracking-widest text-accent-600 uppercase dark:text-accent-400">
          Blog
        </p>
        <span aria-hidden="true" class="text-zinc-300 dark:text-zinc-700">/</span>
        <a
          href="/rss.xml"
          class="font-mono text-xs text-zinc-500 transition-colors hover:text-accent-600 dark:text-zinc-400 dark:hover:text-accent-400"
        >
          RSS ↗
        </a>
      </div>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        Notas y artículos
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty text-zinc-600 dark:text-zinc-400">
        Decisiones de arquitectura cloud, diseño de sistemas distribuidos y aprendizajes construyendo equipos y productos de software.
      </p>
    </header>

    <div class="mt-12 h-px bg-linear-to-r from-zinc-200 via-zinc-200 to-transparent dark:from-zinc-800 dark:via-zinc-800"></div>

    {posts.length === 0 ? (
      <p class="mt-12 font-mono text-sm text-zinc-500">Pronto nuevos artículos.</p>
    ) : (
      <ol class="divide-y divide-zinc-200/80 dark:divide-zinc-800/80">
        {posts.map((post) => {
          const readingTime = getReadingTime(post.body);
          return (
            <li class="group py-8 first:pt-10">
              <article class="grid gap-3 md:grid-cols-[11rem_1fr] md:items-baseline md:gap-8">
                <div class="flex items-center gap-2 font-mono text-xs text-zinc-500 md:flex-col md:items-start md:gap-1 dark:text-zinc-400">
                  <time datetime={post.data.pubDate.toISOString()} class="text-accent-600 dark:text-accent-400">
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span aria-hidden="true" class="md:hidden">·</span>
                  <span>{readingTime} min de lectura</span>
                  {post.data.draft && (
                    <span class="rounded bg-amber-500/15 px-1.5 py-0.5 text-[0.65rem] font-semibold text-amber-600 dark:text-amber-400">
                      BORRADOR
                    </span>
                  )}
                </div>

                <div>
                  <h2 class="text-xl font-semibold tracking-tight text-zinc-900 transition-colors group-hover:text-accent-600 sm:text-2xl dark:text-zinc-100 dark:group-hover:text-accent-400">
                    <a href={`/blog/${post.id}/`} class="block focus:outline-none">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-pretty text-zinc-600 sm:text-base dark:text-zinc-400">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <li class="rounded-full border border-zinc-200 bg-white/60 px-2.5 py-0.5 font-mono text-xs text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-400">
                          #{tag}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    )}
  </main>

  <Footer />
</Base>
