---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<Base title={`404 — ${profile.name}`} description="La página que buscas no existe o fue movida.">
  <Header />
  <main class="mx-auto flex min-h-[calc(100svh-8.5rem)] max-w-6xl flex-col items-start justify-center px-4 py-16 sm:px-6">
    <p class="font-mono text-sm text-accent-600 dark:text-accent-400">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">Página no encontrada.</h1>
    <p class="mt-4 max-w-md text-lg text-zinc-600 dark:text-zinc-400">
      La ruta que intentas abrir no existe o cambió de dirección.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
      >
        ← Volver al inicio
      </a>
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-white/50 px-6 py-3 text-sm font-medium transition hover:border-zinc-900 dark:border-zinc-700 dark:bg-zinc-900/50 dark:hover:border-zinc-300"
      >
        Ir al blog
      </a>
    </div>
  </main>
  <Footer />
</Base>
