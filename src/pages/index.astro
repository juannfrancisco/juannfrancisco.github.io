---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/juan-francisco.png';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { about, certifications, focus, profile, projects, teaching } from '../data/profile';

const year = new Date().getFullYear();
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<Base>
  <!-- Fondo: rejilla sutil y halo cian detrás de la presentación -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[52rem] overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-zinc-200)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-zinc-200)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)] [background-size:3.5rem_3.5rem] opacity-60 dark:bg-[linear-gradient(to_right,var(--color-zinc-800)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-zinc-800)_1px,transparent_1px)]"></div>
    <div data-glow class="absolute top-24 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-accent-500/15 blur-3xl sm:left-2/3"></div>
  </div>

  <Header />

  <main>
    <!-- Presentación -->
    <section data-hero-section class="relative mx-auto flex min-h-[calc(100svh-4rem)] max-w-6xl flex-col justify-center px-4 pt-12 pb-24 sm:px-6">
      <div class="flex flex-col-reverse gap-12 md:flex-row md:items-center md:justify-between">
        <div data-hero-content class="max-w-2xl">
          <p data-hero class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/70 px-3 py-1 font-mono text-xs text-zinc-600 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/70 dark:text-zinc-400">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-500 opacity-60 motion-reduce:hidden"></span>
              <span class="relative inline-flex size-2 rounded-full bg-accent-500"></span>
            </span>
            {profile.location}
          </p>
          <p data-hero class="mt-8 font-mono text-sm text-accent-600 dark:text-accent-400">Hola, soy</p>
          <h1 data-hero-name class="mt-3 text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-7xl">
            {profile.name}
          </h1>
          <p data-hero class="mt-6 text-xl font-medium sm:text-2xl">
            <span class="bg-linear-to-r from-accent-600 to-accent-400 bg-clip-text text-transparent">{profile.role}</span>
          </p>
          <p data-hero class="mt-3 max-w-xl text-lg text-pretty text-zinc-600 dark:text-zinc-400">{profile.headline}</p>
          <div data-hero class="mt-10 flex flex-wrap gap-3">
            <a
              href={`mailto:${profile.email}`}
              class="group inline-flex items-center gap-2 rounded-full bg-zinc-900 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-zinc-900/10 transition hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:shadow-none dark:hover:bg-zinc-200"
            >
              Escríbeme
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
            {profile.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="rounded-full border border-zinc-300 bg-white/50 px-5 py-3 text-sm font-medium backdrop-blur transition hover:border-zinc-900 dark:border-zinc-700 dark:bg-zinc-900/50 dark:hover:border-zinc-300"
              >
                {link.label} ↗
              </a>
            ))}
          </div>
        </div>

        <div data-hero-parallax class="shrink-0">
          <div data-hero-photo class="relative size-40 sm:size-56 md:size-72">
            <svg data-ring aria-hidden="true" viewBox="0 0 100 100" class="absolute -inset-4 size-[calc(100%+2rem)] text-accent-500/60">
              <circle cx="50" cy="50" r="49" fill="none" stroke="currentColor" stroke-width="0.4" stroke-dasharray="1 3" />
            </svg>
            <span data-pulse aria-hidden="true" class="absolute inset-0 rounded-full border-2 border-accent-500 opacity-0"></span>
            <Image
              src={photo}
              alt={`Foto de ${profile.name}`}
              widths={[320, 448, 576, 864]}
              sizes="(min-width: 768px) 288px, (min-width: 640px) 224px, 160px"
              loading="eager"
              fetchpriority="high"
              class="relative size-full rounded-full object-cover ring-4 ring-accent-500/20"
            />
          </div>
        </div>
      </div>

      <a
        href="#sobre-mi"
        data-hero
        aria-label="Ir a Sobre mí"
        class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 sm:flex flex-col items-center gap-2 font-mono text-[0.65rem] tracking-[0.2em] text-zinc-500 uppercase transition-colors hover:text-zinc-900 dark:hover:text-white"
      >
        Scroll
        <span class="relative h-10 w-px overflow-hidden bg-zinc-300 dark:bg-zinc-700">
          <span data-scroll-cue class="absolute inset-x-0 top-0 h-1/2 bg-accent-500"></span>
        </span>
      </a>
    </section>

    <Section id="sobre-mi" index="01" title="Sobre mí" kicker="Tecnología, negocio y personas: lo que hago y cómo lo hago.">
      <div data-reveal-group class="space-y-5">
        {about.map((p, i) => (
          <p
            data-reveal
            class:list={[
              'text-pretty',
              i === 0
                ? 'text-2xl leading-snug font-medium tracking-tight text-zinc-900 dark:text-zinc-100'
                : 'text-lg leading-relaxed text-zinc-600 dark:text-zinc-400',
            ]}
          >
            {p}
          </p>
        ))}
      </div>

      <h3 class="mt-20 font-mono text-xs tracking-widest text-zinc-500 uppercase">Áreas de trabajo</h3>
      <div data-reveal-group class="mt-6 grid gap-4 sm:grid-cols-2">
        {focus.map((item, i) => (
          <div
            data-reveal
            class="group relative overflow-hidden rounded-2xl border border-zinc-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-accent-500/40 hover:shadow-xl hover:shadow-accent-500/5 sm:last:odd:col-span-2 dark:border-zinc-800 dark:bg-zinc-900/50"
          >
            <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-linear-to-r from-accent-500 to-transparent transition-transform duration-500 group-hover:scale-x-100"></span>
            <p class="font-mono text-xs text-accent-600 dark:text-accent-400">{pad(i)}</p>
            <h4 class="mt-3 font-semibold">{item.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{item.body}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-20 font-mono text-xs tracking-widest text-zinc-500 uppercase">Certificaciones</h3>
      <ul data-reveal-group class="mt-6 grid gap-3 sm:grid-cols-2">
        {certifications.map((cert) => (
          <li
            data-reveal
            class="flex items-center gap-4 rounded-2xl border border-zinc-200 bg-white p-4 transition hover:border-accent-500/40 dark:border-zinc-800 dark:bg-zinc-900/50"
          >
            <img src={cert.image} alt="" width="56" height="56" loading="lazy" class="size-14 shrink-0 rounded-xl bg-white object-contain p-1.5 ring-1 ring-zinc-200 dark:ring-zinc-800" />
            <div class="min-w-0 flex-1">
              <p class="leading-snug font-medium">{cert.title}</p>
              <p class="mt-0.5 text-sm text-zinc-500">{cert.issuer}</p>
            </div>
            <span class="self-start rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{cert.year}</span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="proyectos" index="02" title="Proyectos" kicker="Una selección de plataformas y productos que diseñé y construí.">
      <div data-reveal-group class="grid gap-4 sm:grid-cols-2">
        {projects.map((project, i) => (
          <article
            data-reveal
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-accent-500/40 hover:shadow-xl hover:shadow-accent-500/5 dark:border-zinc-800 dark:bg-zinc-900/50"
          >
            <span aria-hidden="true" class="absolute -top-6 -right-2 font-mono text-8xl font-bold text-zinc-100 transition-colors duration-300 group-hover:text-accent-500/10 dark:text-zinc-800/60">
              {pad(i)}
            </span>
            <p class="relative w-fit rounded-full border border-zinc-200 px-2.5 py-0.5 font-mono text-xs text-zinc-500 dark:border-zinc-700">{project.period}</p>
            <h3 class="relative mt-6 text-xl font-semibold tracking-tight">{project.title}</h3>
            <p class="relative mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{project.body}</p>
          </article>
        ))}
      </div>
    </Section>

    <Section id="docencia" index="03" title="Docencia" kicker="Cursos, bootcamps y capacitaciones que he dictado.">
      <ol data-timeline class="relative space-y-10 border-l border-zinc-200 pl-8 dark:border-zinc-800">
        <span data-timeline-line aria-hidden="true" class="absolute top-0 -left-px h-full w-px origin-top bg-accent-500"></span>
        {teaching.map((item) => (
          <li data-timeline-item class="relative">
            <span data-dot class="absolute top-1.5 -left-[2.4rem] size-3 rounded-full border-2 border-accent-500 bg-zinc-50 dark:bg-zinc-950"></span>
            <p class="font-mono text-xs text-accent-600 dark:text-accent-400">{item.period}</p>
            <h3 class="mt-1.5 text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">{item.org}</p>
          </li>
        ))}
      </ol>
    </Section>

    <!-- Contacto -->
    <section id="contacto" data-section class="px-4 pt-8 pb-24 sm:px-6 sm:pb-32">
      <div
        data-contact
        class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-zinc-900 px-6 py-16 text-white sm:px-16 sm:py-24 dark:bg-zinc-900 dark:ring-1 dark:ring-zinc-800"
      >
        <div aria-hidden="true" data-contact-glow class="absolute -top-40 -right-40 size-[28rem] rounded-full bg-accent-500/30 blur-3xl"></div>
        <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_right,rgb(255_255_255/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.04)_1px,transparent_1px)] [background-size:3rem_3rem]"></div>

        <div data-reveal-group class="relative max-w-3xl">
          <p data-reveal class="font-mono text-sm text-accent-400">04 — Contacto</p>
          <h2 data-reveal class="mt-4 text-4xl font-bold tracking-tight text-balance sm:text-6xl">Hablemos.</h2>
          <p data-reveal class="mt-5 max-w-xl text-lg text-pretty text-zinc-400">
            ¿Tienes un proyecto, una charla o una idea que quieras conversar? Escríbeme.
          </p>
          <a
            data-reveal
            href={`mailto:${profile.email}`}
            class="group mt-10 inline-flex flex-wrap items-center gap-3 text-xl font-semibold tracking-tight break-all sm:text-3xl"
          >
            <span class="underline decoration-accent-500 decoration-2 underline-offset-8 transition-colors group-hover:text-accent-400">{profile.email}</span>
            <span aria-hidden="true" class="text-accent-400 transition-transform group-hover:translate-x-1">→</span>
          </a>
          <ul data-reveal class="mt-10 flex flex-wrap gap-3 text-sm">
            {profile.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-block rounded-full border border-white/15 px-4 py-2 font-medium text-zinc-300 transition hover:border-accent-400 hover:text-white"
                >
                  {link.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="pb-10">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-4 px-4 text-sm text-zinc-500 sm:px-6">
      <p>© {year} {profile.name}</p>
      <p class="font-mono">Hecho con Astro + Tailwind + Anime.js</p>
    </div>
  </footer>
</Base>

<script>
  import '../scripts/motion';
</script>
